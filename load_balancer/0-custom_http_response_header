#!/usr/bin/env bash
# Installs nginx and adds an X-Served-By header containing the server hostname
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html
echo "Ceci n'est pas une page" > /var/www/html/404.html
if ! grep -q "redirect_me" /etc/nginx/sites-enabled/default; then
  sed -i '/server_name _;/a \\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-enabled/default
fi
if ! grep -q "error_page 404" /etc/nginx/sites-enabled/default; then
  sed -i '/server_name _;/a \\n\terror_page 404 /404.html;\n\tlocation = /404.html {\n\t\troot /var/www/html;\n\t\tinternal;\n\t}' /etc/nginx/sites-enabled/default
fi
if ! grep -q "X-Served-By" /etc/nginx/sites-enabled/default; then
  sed -i "s/server_name _;/server_name _;\n\tadd_header X-Served-By $(hostname);/" /etc/nginx/sites-enabled/default
fi
service nginx restart
