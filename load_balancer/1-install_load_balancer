#!/usr/bin/env bash
# Installs HAProxy and balances traffic between web-01 and web-02 with roundrobin
apt-get update -y
apt-get install -y haproxy
if ! grep -q "web-backend" /etc/haproxy/haproxy.cfg; then
  cat >> /etc/haproxy/haproxy.cfg <<CFG

frontend http-in
    bind *:80
    mode http
    default_backend web-backend

backend web-backend
    mode http
    balance roundrobin
    server 7372-web-01 16.60.187.80:80 check
    server 7372-web-02 18.130.143.89:80 check
CFG
fi
service haproxy restart
