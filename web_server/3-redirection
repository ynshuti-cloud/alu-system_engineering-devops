#!/usr/bin/env bash
# Installs nginx, serves Holberton School, and 301-redirects /redirect_me
apt-get update -y
apt-get install -y nginx
echo "Holberton School for the win!" > /var/www/html/index.html
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html
if ! grep -q "redirect_me" /etc/nginx/sites-enabled/default; then
  sed -i '/server_name _;/a \\n\tlocation /redirect_me {\n\t\treturn 301 https://www.youtube.com/watch?v=QH2-TGUlwu4;\n\t}' /etc/nginx/sites-enabled/default
fi
service nginx restart
